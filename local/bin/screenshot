#!/usr/bin/env bash
# Hyprland screenshot helper: full | region | window
set -euo pipefail

mode="${1:-full}"
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +'%Y-%m-%d_%H-%M-%S').png"

case "$mode" in
    full)
        grim "$file"
        ;;
    region)
        geometry="$(slurp)" || exit 0
        [[ -z "$geometry" ]] && exit 0
        grim -g "$geometry" "$file"
        ;;
    window)
        geometry="$(hyprctl activewindow -j | jq -r '
            if .address == null or .address == "0x" then empty
            else "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" end')"
        [[ -z "$geometry" ]] && exit 1
        grim -g "$geometry" "$file"
        ;;
    *)
        echo "usage: $0 [full|region|window]" >&2
        exit 1
        ;;
esac

wl-copy < "$file"
notify-send -a Screenshot -i camera-photo "Screenshot saved" "$(basename "$file")" || true
